# Mensagia API token
# Get your token from https://app.mensagia.com/settings/api
MENSAGIA_API_TOKEN=your_api_token_here

# Language (optional): es | ca | gl | eu | en
# If not set, the app will ask on startup (console) or detect the system language (GUI)
MENSAGIA_LANGUAGE=es

# Show item IDs in lists (optional, default: false)
MENSAGIA_SHOW_IDS=false

# Attachment base URL (optional)
# If contact fields contain relative paths instead of full URLs, this base URL is prepended.
# If not set and needed, the console will ask interactively.
MENSAGIA_ATTACHMENT_BASE_URL=https://smslandings.s3.amazonaws.com/images/YOUR-MENSAGIA-UUID

# New version notice (optional, default: true)
# On start-up the app checks GitHub for a newer release and shows a small notice.
# Set to false to turn the check off.
MENSAGIA_CHECK_UPDATES=true

# Version to report when running from the source code (optional, temporary)
# Lets the new version notice be tried without building the app, e.g. v1.3.0.
# Ignored by the executables built from a release tag.
# MENSAGIA_APP_VERSION=v1.3.0
